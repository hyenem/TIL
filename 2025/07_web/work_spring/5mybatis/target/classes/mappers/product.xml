<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.scsa.sf.model.mapper.ProductMapper">
	<insert id="insert">
		insert into product values (#{num}, #{title}, #{price}, #{cno})
	</insert>
	<update id="update">
		update product set title=#{title},price=#{price},cno=#{cno} where num=#{num}
	</update>
	<delete id="delete">
		delete from product where num=#{num}
	</delete>
	<select id="select" resultMap="prodComp">
		select * from product p join company c on p.cno=c.cno
		where num=#{num} order by num
	</select>
	<resultMap type="Product" id="prodComp">
		<id property="num" column="num"/>
		<result property="title" column="title"/>
		<result property="price" column="price"/>
		<result property="cno" column="cno"/>
		<association property="comp" javaType="Company">
			<id property="cno" column="cno"/>
			<result property="name" column="name"/>
			<result property="loc" column="loc"/>
		</association>
	</resultMap>

	<select id="selectAll" parameterType="map" resultMap="prodComp">
		select * from product p join company c on p.cno=c.cno
		<where>
	        <choose>
		        <when test="title != null">
		            title LIKE concat("%",#{title},"%")
		        </when>
		        <when test="price !=null">
		            price &lt;= #{price}
		        </when>
		        <otherwise>
		            1 = 1
		        </otherwise>                    
		    </choose>
	    </where>
	</select>
</mapper>